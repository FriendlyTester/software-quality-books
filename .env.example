# Database (SQLite locally; production uses DATABASE_DATABASE_URL with schema.production.prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Base URL the MCP server uses to call the app's own REST API.
# Optional: defaults to the Vercel production URL, then http://localhost:3000
APP_BASE_URL="http://localhost:3000"
