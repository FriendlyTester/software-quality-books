{
  "type": "module",
  "name": "software-quality-books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "admin:promote:prod": "./scripts/promote-admin-production.sh",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:unit": "vitest run --project unit --project components",
    "test:unit:watch": "vitest --project unit --project components",
    "test:unit:coverage": "vitest run --project unit --project components --coverage",
    "test:pact": "vitest run --project pact",
    "test:api": "playwright test tests/api",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/client": "^6.18.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "dotenv-cli": "^7.4.2",
    "mcp-handler": "^2.3.0",
    "next": "^16.3.6",
    "next-auth": "^4.24.13",
    "node-fetch": "^2.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.2.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.0.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "node-mocks-http": "^1.16.1",
    "postcss": "^8.5.6",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
